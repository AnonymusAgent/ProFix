{
  "name": "profix-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ProFix API \u2014 Express + PostgreSQL (Neon-ready)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "tsx src/db/migrate.ts && tsx src/db/seed.ts",
    "test:smoke": "tsx src/db/smoke-test.ts",
    "dev:memory": "tsx scripts/preview-server.ts",
    "test:e2e": "tsx scripts/e2e-test.ts",
    "db:generate-seed": "tsx scripts/generate-seed.ts",
    "db:verify": "tsx scripts/verify-db.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.11.10",
    "pg-mem": "^3.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  }
}
