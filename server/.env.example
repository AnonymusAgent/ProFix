# Copy to .env — NEVER commit the real .env
# Neon: use the pooled connection string from your Neon dashboard
# (host contains "-pooler"), it already includes ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:8080,http://localhost:5173

# Generate a long random value:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Seeded admin account (created by `npm run db:seed`)
ADMIN_NAME=ProFix Admin
ADMIN_EMAIL=admin@profixservices.com
ADMIN_PASSWORD=Admin@12345
