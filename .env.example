# Frontend env (copy to .env if needed). Defaults work out of the box:
# the app calls the relative "/api" path and Vite proxies it to the backend.
VITE_API_URL=/api

# Neon Auth base URL for customer sign-up/login (Neon Console -> Auth).
# Example: https://ep-your-endpoint.neonauth.us-east-1.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=
